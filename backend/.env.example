# ──────────────────────────────────────────────
# StudyFlow Pro — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── SERVER ────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── DATABASE ──────────────────────────────────
# SQLite (default — no setup needed):
DATABASE_URL="file:./studyflow.db"

# PostgreSQL (production — uncomment and fill in):
# DATABASE_URL="postgresql://user:password@host:5432/studyflow_db?schema=public"

# ── JWT ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-please
JWT_EXPIRES_IN=7d

# ── EMAIL (Nodemailer) ────────────────────────
# Option 1: Gmail with App Password (recommended for dev)
#   1. Enable 2FA on your Google account
#   2. Go to: myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="StudyFlow Pro <your-gmail@gmail.com>"

# Option 2: SendGrid (recommended for production)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your-sendgrid-api-key
# EMAIL_FROM="StudyFlow Pro <noreply@yourdomain.com>"

# Option 3: Mailtrap (for testing — emails captured, not delivered)
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=your-mailtrap-user
# EMAIL_PASS=your-mailtrap-pass
# EMAIL_FROM="StudyFlow Pro <test@studyflow.pro>"

# ── WEB PUSH (FCM-like browser push) ──────────
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_MAILTO=mailto:your-email@example.com

# ── APP ───────────────────────────────────────
APP_NAME=StudyFlow Pro
APP_URL=https://study-flow-pro.onrender.com
